{
  "name": "legally",
  "version": "3.6.0",
  "description": "Check the licenses for the packages that you are using",
  "repository": "github:franciscop/legally",
  "author": "Francisco Presencia <public@francisco.io> (https://francisco.io/)",
  "funding": "https://www.paypal.me/franciscopresencia/19",
  "license": "MIT",
  "keywords": [
    "legally",
    "licenses",
    "check",
    "legal",
    "package",
    "npm",
    "open",
    "opensource"
  ],
  "scripts": {
    "build": "bun build src/index.js --outfile=index.min.js --minify --format=esm --target=node && npm run build:prettier",
    "build:prettier": "prettier --write src *.json",
    "test": "bun test --coverage",
    "lint": "oxlint cli.js src"
  },
  "bin": {
    "legally": "cli.js"
  },
  "main": "index.min.js",
  "type": "module",
  "files": [
    "index.min.js",
    "cli.js"
  ],
  "devDependencies": {
    "files": "^3.0.2",
    "minimist": "^1.2.8",
    "nocolor": "^1.1.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "validate-npm-package-name": "^8.0.0"
  }
}
